# Copy this file to .env and fill it in. Never commit .env: it holds your secrets.

# development on your computer, production on a server.
ENV=development

# A long random value. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required when ENV=production.
SECRET_KEY=

# SQLite on your computer. On a server, PostgreSQL, for example:
#   postgresql+psycopg://portfolio:password@localhost:5432/portfolio
# (docker compose sets this one for you.)
DATABASE_URL=sqlite:///./data/portfolio.db

# The websites allowed to call this server, comma separated, with no path.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,https://sulemsaba.github.io

# This server's own public address, used in image links, e.g. https://api.yourdomain.com
# Empty: the address the request came in on.
PUBLIC_URL=

# Where uploaded images are saved.
MEDIA_DIR=./data/media

# How long a sign-in lasts, in hours.
TOKEN_HOURS=12

# The first admin, created once on start if there is no admin yet.
# You can also leave these empty and run: python -m app.cli create-admin --email ...
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# docker compose only: the PostgreSQL password (letters and numbers only).
POSTGRES_PASSWORD=
